[Unit]
Description=SAM Rover Teleoperation Web & Autonomy Server
After=network.target network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/sam3/sam
ExecStart=/home/sam3/sam/.venv/bin/python -m uvicorn server.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
TimeoutStopSec=2s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
